{
  "description": "local-shunt: block full reads of large text files and point Claude to the worker model",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/local-shunt\" hook pre-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/local-shunt\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
